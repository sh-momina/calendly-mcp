# --- Single tenant (start here) ---------------------------------
# Any long random string. This is what you paste into n8n / ElevenLabs.
# Generate one with:  openssl rand -hex 32
MCP_API_KEY=

# Calendly personal access token from
# https://calendly.com/integrations/api_webhooks
CALENDLY_TOKEN=

# --- Multiple customers (optional) ------------------------------
# Each customer gets their own api_key mapped to their own Calendly token.
# TENANTS_JSON=[{"api_key":"sk_alice_...","calendly_token":"eyJ...","label":"Alice"}]

PORT=3000
